players = []

from functools import wraps


@wraps
def _unused(function):
    return function


def log_action(function):
    @wraps(function)
    def wrapper(*args, **kwargs):
        print("\nAction:", function.__name__)
        return function(*args, **kwargs)
    return wrapper


def player_required(function):
    @wraps(function)
    def wrapper(*args, **kwargs):
        if not players:
            print("\nThere are no players on the team.")
            return
        return function(*args, **kwargs)
    return wrapper


class Player:
    def __init__(self, player_id, name, age, position, jersey_number, notes=""):
        self.__player_id = player_id
        self.__name = name.strip()
        self.__age = age
        self.__position = position.strip()
        self.__jersey_number = jersey_number
        self.__notes = notes.strip()
        self.__games = self.__points = self.__assists = 0
        self.__rebounds = self.__steals = self.__blocks = 0
        self.__game_notes = []

    @property
    def player_id(self): return self.__player_id
    @property
    def name(self): return self.__name
    @property
    def age(self): return self.__age
    @property
    def position(self): return self.__position
    @property
    def jersey_number(self): return self.__jersey_number
    @property
    def notes(self): return self.__notes
    @property
    def games(self): return self.__games
    @property
    def points(self): return self.__points
    @property
    def assists(self): return self.__assists
    @property
    def rebounds(self): return self.__rebounds
    @property
    def steals(self): return self.__steals
    @property
    def blocks(self): return self.__blocks
    @property
    def game_notes(self): return self.__game_notes

    def set_player_id(self, player_id):
        self.__player_id = player_id

    def average(self, value):
        return value / self.__games if self.__games else 0

    @property
    def points_per_game(self): return self.average(self.__points)
    @property
    def assists_per_game(self): return self.average(self.__assists)
    @property
    def rebounds_per_game(self): return self.average(self.__rebounds)
    @property
    def steals_per_game(self): return self.average(self.__steals)
    @property
    def blocks_per_game(self): return self.average(self.__blocks)

    def update_profile(self, name=None, age=None, position=None, jersey_number=None, notes=None):
        if name is not None: self.__name = name.strip()
        if age is not None: self.__age = age
        if position is not None: self.__position = position.strip()
        if jersey_number is not None: self.__jersey_number = jersey_number
        if notes is not None: self.__notes = notes.strip()

    def record_game(self, points, assists, rebounds, steals, blocks, notes=""):
        values = (points, assists, rebounds, steals, blocks)
        if any(value < 0 for value in values):
            raise ValueError("Player statistics cannot be negative.")
        self.__games += 1
        self.__points += points
        self.__assists += assists
        self.__rebounds += rebounds
        self.__steals += steals
        self.__blocks += blocks
        self.__game_notes.append(notes.strip())

    def __str__(self):
        return f"#{self.__jersey_number} {self.__name} | {self.__position} | Age: {self.__age}"

    def __eq__(self, other):
        return isinstance(other, Player) and self.player_id == other.player_id


class Team:
    def __init__(self, name):
        self.name = name
        self.__wins = self.__losses = 0
        self.__game_stats = []

    @property
    def wins(self): return self.__wins
    @property
    def losses(self): return self.__losses
    @property
    def games_played(self): return self.__wins + self.__losses
    @property
    def win_percentage(self):
        return self.__wins / self.games_played * 100 if self.games_played else 0
    @property
    def game_stats(self): return self.__game_stats

    def record_game(self, result, team_score, opponent_score, assists, rebounds, steals, blocks, notes=""):
        values = (team_score, opponent_score, assists, rebounds, steals, blocks)
        if any(value < 0 for value in values):
            raise ValueError("Team statistics cannot be negative.")
        if result == "y": self.__wins += 1
        else: self.__losses += 1
        self.__game_stats.append({
            "team_score": team_score,
            "opponent_score": opponent_score,
            "assists": assists,
            "rebounds": rebounds,
            "steals": steals,
            "blocks": blocks,
            "result": "Win" if result == "y" else "Loss",
            "notes": notes.strip(),
        })

    def total_stat(self, statistic):
        return sum(game[statistic] for game in self.__game_stats)

    def __len__(self): return len(players)
    def __iter__(self): return iter(players)


class PlayerFactory:
    @staticmethod
    def create_player(player_id, name, age, position, jersey_number, notes=""):
        return Player(player_id, name, age, position, jersey_number, notes)


class PlayerProxy:
    def __init__(self, player): self.__player = player

    def show_details(self):
        player = self.__player
        print("\nPlayer Details")
        for label, value in (
            ("ID", player.player_id), ("Name", player.name),
            ("Age", player.age), ("Position", player.position),
            ("Jersey Number", player.jersey_number), ("Notes", player.notes),
            ("Games", player.games), ("Total Points", player.points),
            ("Average Points Per Game", f"{player.points_per_game:.2f}"),
            ("Total Assists", player.assists),
            ("Average Assists Per Game", f"{player.assists_per_game:.2f}"),
            ("Total Rebounds", player.rebounds),
            ("Average Rebounds Per Game", f"{player.rebounds_per_game:.2f}"),
            ("Total Steals", player.steals),
            ("Average Steals Per Game", f"{player.steals_per_game:.2f}"),
            ("Total Blocks", player.blocks),
            ("Average Blocks Per Game", f"{player.blocks_per_game:.2f}")):
            print(f"{label}: {value}")
        if player.game_notes:
            print("Player Statistic Notes:")
            for number, note in enumerate(player.game_notes, 1):
                print(f"  Game {number}: {note or '(none)'}")


class Statistics:
    def __init__(self, team): self.team = team

    def team_overview(self):
        print("\nTeam Overview")
        print(f"Team: {self.team.name}")
        print(f"Players: {len(self.team)}")
        print(f"Games Played: {self.team.games_played}")
        print(f"Team Points: {self.team.total_stat('team_score')}")
        print(f"Opponent Points: {self.team.total_stat('opponent_score')}")
        for statistic in ("points", "assists", "rebounds", "steals", "blocks"):
            print(f"{statistic.title()}: {sum(getattr(p, statistic) for p in self.team)}")
        for statistic in ("assists", "rebounds", "steals", "blocks"):
            print(f"Team {statistic.title()}: {self.team.total_stat(statistic)}")

    def team_game_statistics(self):
        print("\nTeam Game Statistics")
        if not self.team.game_stats:
            print("No team games have been recorded.")
            return
        for number, game in enumerate(self.team.game_stats, 1):
            print(f"\nGame {number}: {game['result']}")
            print(f"Score: {game['team_score']} - {game['opponent_score']}")
            print(f"Assists: {game['assists']}")
            print(f"Rebounds: {game['rebounds']}")
            print(f"Steals: {game['steals']}")
            print(f"Blocks: {game['blocks']}")
            print(f"Notes: {game['notes'] or '(none)'}")

    def get_leader(self, statistic):
        return max(self.team, key=lambda p: getattr(p, statistic), default=None)

    def show_leader(self, statistic, title, unit):
        player = self.get_leader(statistic)
        print(f"\n{title}")
        if player: print(f"{player.name}: {getattr(player, statistic)} {unit}")

    def menu(self):
        actions = {
            "1": self.team_overview,
            "2": lambda: self.show_leader("points", "Scoring Leader", "points"),
            "3": lambda: self.show_leader("assists", "Assist Leader", "assists"),
            "4": lambda: self.show_leader("rebounds", "Rebound Leader", "rebounds"),
            "5": lambda: self.show_leader("steals", "Steals Leader", "steals"),
            "6": lambda: self.show_leader("blocks", "Blocks Leader", "blocks"),
            "7": lambda: self.top_three("points", "Top 3 Scorers", "points"),
            "8": lambda: self.top_three("assists", "Top 3 Assist Leaders", "assists"),
            "9": self.player_averages,
            "10": self.player_statistics,
            "11": self.team_record,
            "12": self.team_game_statistics,
        }
        while True:
            print("\nStatistics\n1. Team Overview\n2. Scoring Leader\n3. Assist Leader")
            print("4. Rebound Leader\n5. Steals Leader\n6. Blocks Leader")
            print("7. Top 3 Scorers\n8. Top 3 Assist Leaders\n9. Player Averages")
            print("10. Player Statistics\n11. Team Record\n12. Team Game Statistics\n13. Back")
            choice = input("\nChoose an option: ")
            if choice == "13": return
            if choice in actions: actions[choice]()
            else: print("Invalid option.")

    def top_three(self, statistic, title, unit):
        print(f"\n{title}")
        for number, player in enumerate(sorted(self.team, key=lambda p: getattr(p, statistic), reverse=True)[:3], 1):
            print(f"{number}. {player.name} - {getattr(player, statistic)} {unit}")

    def player_averages(self):
        print("\nPlayer Averages")
        for player in self.team:
            print(f"\n{player.name}")
            print(f"PPG: {player.points_per_game:.2f}")
            print(f"APG: {player.assists_per_game:.2f}")
            print(f"RPG: {player.rebounds_per_game:.2f}")
            print(f"SPG: {player.steals_per_game:.2f}")
            print(f"BPG: {player.blocks_per_game:.2f}")

    def player_statistics(self):
        player = find_player(input("Enter player ID: "))
        if player: PlayerProxy(player).show_details()
        else: print("Player not found.")

    def team_record(self):
        print(f"\nTeam Record\nWins: {self.team.wins}\nLosses: {self.team.losses}")
        print(f"Games Played: {self.team.games_played}")
        print(f"Win Percentage: {self.team.win_percentage:.2f}%")


def get_integer(prompt):
    while True:
        try: return int(input(prompt))
        except ValueError: print("Please enter a valid number.")


def find_player(player_id):
    player_id = str(player_id).strip().upper()
    return next((player for player in players if player.player_id == player_id), None)


def next_player_id():
    return f"PLAYER{len(players) + 1:02d}"


def renumber_players():
    for number, player in enumerate(players, 1):
        player.set_player_id(f"PLAYER{number:02d}")


@log_action
def add_player(team):
    print("\nAdd Player")
    player_id = next_player_id()
    print(f"Generated Player ID: {player_id}")

    name = input("Name: ").strip()
    if not name:
        print("Name cannot be empty.")
        return

    while True:
        age = get_integer("Age: ")
        if age < 18:
            print("Invalid age. Player must be 18 or older.")
        elif age > 42:
            print("Invalid Age. Player must be 42 or younger.")
        else:
            break

    position = input("Position: ").strip()
    if not position:
        print("Position cannot be empty.")
        return

    jersey_number = get_integer("Jersey Number: ")
    if jersey_number <= 0:
        print("Jersey number must be positive.")
        return
    if any(player.jersey_number == jersey_number for player in players):
        print("That jersey number is already being used.")
        return

    notes = input("Notes (optional): ").strip()
    players.append(PlayerFactory.create_player(player_id, name, age, position, jersey_number, notes))
    print(f"{name} was added successfully with ID {player_id}.")


@player_required
def view_players(team):
    print("\nTeam Players")
    for number, player in enumerate(team, 1):
        print(f"{number}. ID: {player.player_id} | {player}")


@player_required
def delete_player(team):
    print("\nDelete Player")
    for number, player in enumerate(team, 1):
        print(f"{number}. {player.player_id} - {player.name}")

    choice = get_integer("Enter the number of the player to delete: ")
    if choice < 1 or choice > len(players):
        print("Invalid player number.")
        return

    player = players[choice - 1]
    confirmation = input(f"Delete {player.name} ({player.player_id})? (y/n): ").strip().lower()
    if confirmation != "y":
        print("Deletion cancelled.")
        return

    del players[choice - 1]
    renumber_players()
    print(f"{player.name} was deleted successfully.")


@player_required
def record_game(team):
    print("\nRecord Game")
    result = input("Did the team win? (y/n): ").strip().lower()
    if result not in ("y", "n"):
        print("Invalid result.")
        return

    team_score = get_integer("Team score: ")
    opponent_score = get_integer("Opponent score: ")
    team_values = [get_integer(label) for label in (
        "Team assists: ", "Team rebounds: ", "Team steals: ", "Team blocks: ")]
    team_notes = input("Team statistics notes (optional): ").strip()

    entered_values = [team_score, opponent_score] + team_values
    if any(value < 0 for value in entered_values):
        print("Team statistics cannot be negative.")
        return

    player_values = []
    for player in team:
        print(f"\n{player.name}")
        values = [get_integer(label) for label in ("Points: ", "Assists: ", "Rebounds: ", "Steals: ", "Blocks: ")]
        player_notes = input("Player statistics notes (optional): ").strip()
        if any(value < 0 for value in values):
            print("Player statistics cannot be negative.")
            return
        player_values.append((player, values, player_notes))

    team.record_game(result, team_score, opponent_score, *team_values, team_notes)
    for player, values, player_notes in player_values:
        player.record_game(*values, player_notes)
    print("\nGame recorded successfully.")


@player_required
def search_players(team):
    search = input("\nSearch name or position: ").lower().strip()
    matches = [player for player in team if search in player.name.lower() or search in player.position.lower()]
    if matches:
        for player in matches: print(player)
    else: print("No players found.")


@player_required
def edit_player(team):
    player = find_player(input("\nEnter player ID: "))
    if player is None:
        print("Player not found.")
        return
    print("\n1. Edit Name\n2. Edit Age\n3. Edit Position\n4. Edit Jersey Number\n5. Edit Notes\n6. Back")
    choice = input("\nChoose an option: ")
    if choice == "1":
        name = input("New name: ").strip()
        if name: player.update_profile(name=name)
        else: print("Name cannot be empty.")
    elif choice == "2":
        age = get_integer("New age: ")
        if age < 18: print("Invalid age. Player must be 18 or older.")
        elif age > 42: print("Invalid Age. Player must be 42 or younger.")
        else: player.update_profile(age=age)
    elif choice == "3":
        position = input("New position: ").strip()
        if position: player.update_profile(position=position)
        else: print("Position cannot be empty.")
    elif choice == "4":
        jersey = get_integer("New jersey number: ")
        if jersey <= 0: print("Jersey number must be positive.")
        elif any(p != player and p.jersey_number == jersey for p in players): print("That jersey number is already being used.")
        else: player.update_profile(jersey_number=jersey)
    elif choice == "5":
        player.update_profile(notes=input("New notes: "))
        print("Player notes updated.")
    elif choice != "6": print("Invalid option.")


if __name__ == "__main__":
    team = Team("Basketball Team")

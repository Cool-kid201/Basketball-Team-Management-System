players = []

from functools import wraps


def log_action(function):
    @wraps(function)
    def wrapper(*args, **kwargs):
        print("\nAction:", function.__name__)
        return function(*args, **kwargs)
    return wrapper


def player_required(function):
    @wraps(function)
    def wrapper(*args, **kwargs):
        if not players:
            print("\nThere are no players on the team.")
            return
        return function(*args, **kwargs)
    return wrapper


class Player:
    def __init__(self, player_id: str, name: str, age: int, position: str,
                 jersey_number: int):
        self.__player_id = player_id
        self.__name = name.strip()
        self.__age = age
        self.__position = position.strip()
        self.__jersey_number = jersey_number
        self.__games = self.__points = self.__assists = 0
        self.__rebounds = self.__steals = self.__blocks = 0

    @property
    def player_id(self): return self.__player_id
    @property
    def name(self): return self.__name
    @property
    def age(self): return self.__age
    @property
    def position(self): return self.__position
    @property
    def jersey_number(self): return self.__jersey_number
    @property
    def games(self): return self.__games
    @property
    def points(self): return self.__points
    @property
    def assists(self): return self.__assists
    @property
    def rebounds(self): return self.__rebounds
    @property
    def steals(self): return self.__steals
    @property
    def blocks(self): return self.__blocks

    def _average(self, value):
        return value / self.__games if self.__games else 0

    @property
    def points_per_game(self): return self._average(self.__points)
    @property
    def assists_per_game(self): return self._average(self.__assists)
    @property
    def rebounds_per_game(self): return self._average(self.__rebounds)
    @property
    def steals_per_game(self): return self._average(self.__steals)
    @property
    def blocks_per_game(self): return self._average(self.__blocks)

    def update_profile(self, name=None, age=None, position=None, jersey_number=None):
        if name is not None: self.__name = name.strip()
        if age is not None: self.__age = age
        if position is not None: self.__position = position.strip()
        if jersey_number is not None: self.__jersey_number = jersey_number

    def record_game(self, points, assists, rebounds, steals, blocks):
        values = (points, assists, rebounds, steals, blocks)
        if any(value < 0 for value in values):
            raise ValueError("Player statistics cannot be negative.")
        self.__games += 1
        self.__points += points
        self.__assists += assists
        self.__rebounds += rebounds
        self.__steals += steals
        self.__blocks += blocks

    def __str__(self):
        return f"#{self.__jersey_number} {self.__name} | {self.__position} | Age: {self.__age}"

    def __repr__(self):
        return f"Player(id='{self.__player_id}', name='{self.__name}')"

    def __eq__(self, other):
        return isinstance(other, Player) and self.__player_id == other.player_id

    def __lt__(self, other): return self.__points < other.points


class Team:
    def __init__(self, name):
        self.name = name
        self.__wins = self.__losses = 0

    @property
    def wins(self): return self.__wins
    @property
    def losses(self): return self.__losses
    @property
    def games_played(self): return self.__wins + self.__losses
    @property
    def win_percentage(self):
        return self.__wins / self.games_played * 100 if self.games_played else 0

    def record_win(self): self.__wins += 1
    def record_loss(self): self.__losses += 1
    def __len__(self): return len(players)
    def __iter__(self): return iter(players)
    def __contains__(self, player_id): return find_player(player_id) is not None


class PlayerFactory:
    @staticmethod
    def create_player(player_id, name, age, position, jersey_number):
        return Player(player_id, name, age, position, jersey_number)


class PlayerProxy:
    def __init__(self, player): self.__player = player

    def show_details(self):
        p = self.__player
        print("\nPlayer Details")
        for label, value in (("ID", p.player_id), ("Name", p.name), ("Age", p.age),
                             ("Position", p.position), ("Jersey Number", p.jersey_number),
                             ("Games", p.games), ("Points", p.points),
                             ("Assists", p.assists), ("Rebounds", p.rebounds),
                             ("Steals", p.steals), ("Blocks", p.blocks)):
            print(f"{label}: {value}")


class Statistics:
    def __init__(self, team): self.team = team

    def team_overview(self):
        totals = {key: sum(getattr(p, key) for p in self.team)
                  for key in ("points", "assists", "rebounds", "steals", "blocks")}
        print("\nTeam Overview")
        print(f"Team: {self.team.name}\nPlayers: {len(self.team)}")
        print(f"Games Played: {self.team.games_played}")
        for key, value in totals.items(): print(f"{key.title()}: {value}")

    def get_leader(self, statistic):
        return max(self.team, key=lambda p: getattr(p, statistic), default=None)

    def leader(self, statistic, title, unit):
        player = self.get_leader(statistic)
        print(f"\n{title}")
        if player: print(f"{player.name}: {getattr(player, statistic)} {unit}")

    def scoring_leader(self): self.leader("points", "Scoring Leader", "points")
    def assist_leader(self): self.leader("assists", "Assist Leader", "assists")
    def rebound_leader(self): self.leader("rebounds", "Rebound Leader", "rebounds")
    def steals_leader(self): self.leader("steals", "Steals Leader", "steals")
    def blocks_leader(self): self.leader("blocks", "Blocks Leader", "blocks")

    def top_3(self, statistic, title, unit):
        print(f"\n{title}")
        ordered = sorted(self.team, key=lambda p: getattr(p, statistic), reverse=True)
        for number, player in enumerate(ordered[:3], 1):
            print(f"{number}. {player.name} - {getattr(player, statistic)} {unit}")

    def top_3_scorers(self): self.top_3("points", "Top 3 Scorers", "points")
    def top_3_assist_leaders(self): self.top_3("assists", "Top 3 Assist Leaders", "assists")

    def player_averages(self):
        print("\nPlayer Averages")
        for p in self.team:
            print(f"\n{p.name}\nPPG: {p.points_per_game:.2f}\nAPG: {p.assists_per_game:.2f}\n"
                  f"RPG: {p.rebounds_per_game:.2f}\nSPG: {p.steals_per_game:.2f}\nBPG: {p.blocks_per_game:.2f}")

    def player_statistics(self):
        player_id = input("Enter player ID (for example, PLAYER01): ").strip().upper()
        player = find_player(player_id)
        if player is None: print("Player not found.")
        else: PlayerProxy(player).show_details()

    def team_record(self):
        print(f"\nTeam Record\nWins: {self.team.wins}\nLosses: {self.team.losses}\n"
              f"Games Played: {self.team.games_played}\nWin Percentage: {self.team.win_percentage:.2f}%")

    def menu(self):
        actions = {"1": self.team_overview, "2": self.scoring_leader,
                   "3": self.assist_leader, "4": self.rebound_leader,
                   "5": self.steals_leader, "6": self.blocks_leader,
                   "7": self.top_3_scorers, "8": self.top_3_assist_leaders,
                   "9": self.player_averages, "10": self.player_statistics,
                   "11": self.team_record}
        while True:
            print("\nStatistics\n1. Team Overview\n2. Scoring Leader\n3. Assist Leader\n"
                  "4. Rebound Leader\n5. Steals Leader\n6. Blocks Leader\n7. Top 3 Scorers\n"
                  "8. Top 3 Assist Leaders\n9. Player Averages\n10. Player Statistics\n"
                  "11. Team Record\n12. Back")
            choice = input("\nChoose an option: ")
            if choice == "12": return
            if choice in actions: actions[choice]()
            else: print("Invalid option.")


def get_integer(prompt):
    while True:
        try: return int(input(prompt))
        except ValueError: print("Please enter a valid number.")


def find_player(player_id):
    player_id = str(player_id).strip().upper()
    return next((p for p in players if p.player_id == player_id), None)


def next_player_id():
    """Return the next sequential ID: PLAYER01, PLAYER02, and so on."""
    return f"PLAYER{len(players) + 1:02d}"


@log_action
def add_player(team):
    print("\nAdd Player")
    player_id = next_player_id()
    print(f"Generated Player ID: {player_id}")

    name = input("Name: ").strip()
    if not name:
        print("Name cannot be empty.")
        return

    while True:
        age = get_integer("Age: ")
        if age < 18:
            print("Invalid age. Player must be 18 or older.")
        elif age > 42:
            print("Invalid Age. Player must be 42 or younger.")
        else:
            break

    position = input("Position: ").strip()
    if not position:
        print("Position cannot be empty.")
        return

    jersey_number = get_integer("Jersey Number: ")
    if jersey_number <= 0:
        print("Jersey number must be positive.")
        return
    if any(p.jersey_number == jersey_number for p in players):
        print("That jersey number is already being used.")
        return

    players.append(PlayerFactory.create_player(player_id, name, age, position, jersey_number))
    print(f"{name} was added successfully with ID {player_id}.")


@player_required
def view_players(team):
    print("\nTeam Players")
    for player in team: print(f"ID: {player.player_id} | {player}")


@player_required
def record_game(team):
    print("\nRecord Game")
    result = input("Did the team win? (y/n): ").lower().strip()
    if result == "y": team.record_win()
    elif result == "n": team.record_loss()
    else:
        print("Invalid result.")
        return
    for player in team:
        print(f"\n{player.name}")
        values = [get_integer(label) for label in ("Points: ", "Assists: ", "Rebounds: ", "Steals: ", "Blocks: ")]
        try: player.record_game(*values)
        except ValueError as error:
            print(error)
            return
    print("\nGame recorded successfully.")


@player_required
def search_players(team):
    search = input("\nSearch name or position: ").lower().strip()
    found = False
    for player in team:
        if search in player.name.lower() or search in player.position.lower():
            print(player)
            found = True
    if not found: print("No players found.")


@player_required
def edit_player(team):
    player_id = input("\nEnter player ID (for example, PLAYER01): ").strip().upper()
    player = find_player(player_id)
    if player is None:
        print("Player not found.")
        return
    print("\n1. Edit Name\n2. Edit Age\n3. Edit Position\n4. Edit Jersey Number\n5. Back")
    choice = input("\nChoose an option: ")
    if choice == "1":
        name = input("New name: ").strip()
        if not name: print("Name cannot be empty.")
        else: player.update_profile(name=name)
    elif choice == "2":
        age = get_integer("New age: ")
        if age < 18: print("Invalid age. Player must be 18 or older.")
        elif age > 42: print("Invalid Age. Player must be 42 or younger.")
        else: player.update_profile(age=age)
    elif choice == "3":
        position = input("New position: ").strip()
        if not position: print("Position cannot be empty.")
        else: player.update_profile(position=position)
    elif choice == "4":
        jersey_number = get_integer("New jersey number: ")
        if jersey_number <= 0: print("Jersey number must be positive.")
        elif any(p.player_id != player.player_id and p.jersey_number == jersey_number for p in players):
            print("That jersey number is already being used.")
        else: player.update_profile(jersey_number=jersey_number)
    elif choice != "5": print("Invalid option.")


if __name__ == "__main__":
    team = Team("Basketball Team")
    stats = Statistics(team)
    actions = {"1": lambda: add_player(team), "2": lambda: view_players(team),
               "3": lambda: record_game(team), "4": lambda: search_players(team),
               "5": lambda: edit_player(team), "6": stats.menu}
    while True:
        print("\nMenu\n1. Add Player\n2. View Players\n3. Record Game\n4. Search Players\n"
              "5. Edit Player\n6. Statistics\n7. Exit")
        choice = input("\nChoose an option: ")
        if choice == "7": break
        if choice in actions: actions[choice]()
        else: print("Invalid option.")
